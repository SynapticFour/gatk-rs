#!/usr/bin/env bash
# Versioned pre-commit hook for gatk-rs (enable via scripts/dev/install-hooks.sh).
# Compatible with macOS Bash 3.2 (no mapfile / namerefs).
set -euo pipefail
# macOS 27: ld-1267 cannot read arm64e.x1 in the CLT SDK. See macos-sdk.sh.
# shellcheck disable=SC1091
source "$(git rev-parse --show-toplevel)/scripts/hooks/macos-sdk.sh"
use_linkable_macos_sdk

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [[ -z "${STAGED}" ]]; then
  exit 0
fi

has_rs=0
has_md=0
has_doc_rs=0
crates=""

crate_for_path() {
  case "$1" in
    gatk-cli/*) echo gatk-cli ;;
    gatk-common/*) echo gatk-common ;;
    gatk-core/*) echo gatk-core ;;
    gatk-haplotypecaller/*) echo gatk-haplotypecaller ;;
    gatk-rs-equiv/*) echo gatk-rs-equiv ;;
    *) echo "" ;;
  esac
}

while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  case "$f" in
    *.rs)
      has_rs=1
      if git show ":$f" 2>/dev/null | grep -q '^[[:space:]]*///'; then
        has_doc_rs=1
      fi
      c="$(crate_for_path "$f")"
      if [[ -n "$c" ]] && ! echo " $crates " | grep -q " $c "; then
        crates="${crates} ${c}"
      fi
      ;;
    *.md) has_md=1 ;;
  esac
done <<EOF
${STAGED}
EOF

# 1) fmt — only when Rust staged
if [[ "$has_rs" -eq 1 ]]; then
  echo "[pre-commit] cargo fmt --check"
  cargo fmt --all -- --check
fi

# 2) clippy — scoped to affected crates when possible; else workspace.
# Rustc compiler warnings fail the commit. Clippy lints stay non-blocking
# (`-A clippy::all`). `dead_code` stays allowed: this crate keeps unused
# Java-shaped helpers and test-only `pub` items that lib-only clippy cannot
# see as used. Do not put `#![deny(warnings)]` in crate roots.
# No --all-targets: integration tests need feature-gated private modules.
if [[ "$has_rs" -eq 1 ]]; then
  clippy_args=""
  for c in $crates; do
    clippy_args="${clippy_args} -p ${c}"
  done
  if [[ -n "$clippy_args" ]]; then
    echo "[pre-commit] cargo clippy${clippy_args} (deny rustc warnings)"
    # shellcheck disable=SC2086
    cargo clippy ${clippy_args} -- -D warnings -A clippy::all -A dead_code
  else
    echo "[pre-commit] cargo clippy --workspace (deny rustc warnings)"
    cargo clippy --workspace -- -D warnings -A clippy::all -A dead_code
  fi
fi

# 3) unwrap/clone ratchet — always (fast)
if [[ -x scripts/dev/count_unsafe_patterns.sh ]]; then
  echo "[pre-commit] unsafe-pattern ratchets"
  ./scripts/dev/count_unsafe_patterns.sh check
fi

# 4) markdown / path doc links — when .md or ///-bearing .rs staged
if [[ "$has_md" -eq 1 || "$has_doc_rs" -eq 1 ]]; then
  if [[ -f scripts/dev/check_doc_links.py ]]; then
    echo "[pre-commit] doc link check"
    python3 scripts/dev/check_doc_links.py
  fi
fi

# 4b) rustdoc intra-doc links — matches CI Documentation Quality
# (`RUSTDOCFLAGS=-D rustdoc::broken_intra_doc_links`). Scoped to affected crates.
if [[ "$has_doc_rs" -eq 1 ]]; then
  doc_args=""
  for c in $crates; do
    doc_args="${doc_args} -p ${c}"
  done
  if [[ -z "$doc_args" ]]; then
    doc_args="--workspace"
  fi
  echo "[pre-commit] cargo doc${doc_args} (broken intra-doc links)"
  # shellcheck disable=SC2086
  RUSTDOCFLAGS="-D rustdoc::broken_intra_doc_links" cargo doc ${doc_args} --no-deps
fi

# 5) Excellence gates (N-1 coords, N-2 env, …) — matches CI quality.yml.
# Fast Python; catches bare `923*****` / allowlist drift before push.
has_excellence=0
if [[ "$has_rs" -eq 1 ]]; then
  has_excellence=1
fi
while IFS= read -r f; do
  case "$f" in
    scripts/parity/coord_allowlist.json|scripts/parity/excellence_gates_audit.py|scripts/parity/p12_site_id_audit.py)
      has_excellence=1
      ;;
  esac
done <<EOF
${STAGED}
EOF
if [[ "$has_excellence" -eq 1 && -f scripts/parity/excellence_gates_audit.py ]]; then
  echo "[pre-commit] excellence gates (N-1…N-7)"
  python3 scripts/parity/excellence_gates_audit.py
fi

# 6) block staged files >1 MiB
MAX=$((1024 * 1024))
oversized=0
while IFS= read -r f; do
  [[ -z "$f" || ! -f "$f" ]] && continue
  size=$(wc -c <"$f" | tr -d ' ')
  if [[ "$size" -gt "$MAX" ]]; then
    echo "[pre-commit] ERROR: staged file exceeds 1 MiB: $f ($size bytes)" >&2
    oversized=1
  fi
done <<EOF
${STAGED}
EOF
if [[ "$oversized" -eq 1 ]]; then
  echo "[pre-commit] Refuse commit of files >1 MiB. Use --no-verify only if intentional." >&2
  exit 1
fi

# 7) lib tests when Rust staged (catches CI test failures early)
if [[ "$has_rs" -eq 1 ]]; then
  echo "[pre-commit] cargo test --workspace --lib"
  cargo test --workspace --lib
fi

# 8) HaplotypeCaller source-contract integration tests.
# `cargo test --lib` does not compile gatk-haplotypecaller/tests/*.rs, so a
# green lib suite still lets CI fail on the next forensic_*_source check.
# Only those source functions run here. Live chr20/P12 bodies stay out: a
# name filter of `_source_` also matches live tests such as
# read_pos_rank_sum_source_arrow, which need local fixtures CI does not have.
if echo " $crates " | grep -q " gatk-haplotypecaller "; then
  echo "[pre-commit] haplotypecaller source-contract tests"
  source_bins=$(grep -lE 'fn forensic_6r[0-9]+_source' gatk-haplotypecaller/tests/*.rs || true)
  while IFS= read -r src; do
    [[ -z "$src" ]] && continue
    bin=$(basename "$src" .rs)
    echo "[pre-commit] source contract: ${bin}"
    cargo test -p gatk-haplotypecaller --test "$bin" _source -- --test-threads=8 --skip live
  done <<EOF
${source_bins}
EOF
fi

# 9) Forensic tests CI cannot skip. They carry committed tables and do not
# return when the chr20 BAM is absent, so a *_source-only gate never sees them.
if echo " $crates " | grep -q " gatk-haplotypecaller "; then
  echo "[pre-commit] haplotypecaller always-on forensic tests"
  always_on=$(python3 - <<'PY'
import pathlib, re
root = pathlib.Path("gatk-haplotypecaller/tests")
for path in sorted(root.glob("forensic_6r*.rs")):
    number = re.search(r"forensic_6r(\d+)", path.name)
    if not number or int(number.group(1)) < 284:
        continue
    text = path.read_text(encoding="utf-8", errors="replace")
    parts = re.split(r"\n#\[test\]\n", text)
    for part in parts[1:]:
        match = re.match(r"fn\s+(\w+)", part)
        if not match:
            continue
        body = part.split("\n#[test]\n", 1)[0]
        if "is_file()" in body or 'env::var("HOLDOUT' in body or 'env::var("FORENSIC_' in body:
            continue
        print(f"{path.stem} {match.group(1)}")
PY
)
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    bin=${row%% *}
    fn=${row#* }
    echo "[pre-commit] always-on: ${fn}"
    cargo test -p gatk-haplotypecaller --test "$bin" "$fn" -- --test-threads=8
  done <<EOF
${always_on}
EOF
  # 6R.298 keeps its TSV asserts on CI and skips the Homebrew JDK probe.
  echo "[pre-commit] always-on: forensic_6r298_java_avx_vs_logless"
  cargo test -p gatk-haplotypecaller --test forensic_6r298_java_avx_vs_logless -- --test-threads=8
fi

echo "[pre-commit] ok"
exit 0
