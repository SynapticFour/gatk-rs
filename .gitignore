# Local GATK source checkout for parity porting (not vendored)
.gatk-src/

# Local backup of pre-public git history (never publish)
.git.pre-public-backup/

# ---------------------------------------------------------------------------
# Rust build artifacts
# ---------------------------------------------------------------------------
/target/
**/target/
/target-agent/
/target-foundation/
/target-parity/
/target-p10-release/
/target-udeps/
.docker-amd64-target/
.rustup-local/
.cargo-local/
**/*.rs.bk

# Cargo.lock decision:
# gatk-cli ships a binary target (`gatk-rs`). Per Rust best practice for
# applications/binaries, Cargo.lock MUST be committed for reproducible
# builds (CI + end users). Do NOT add Cargo.lock to this ignore list.
# (Verified: gatk-cli/Cargo.toml has [[bin]] name = "gatk-rs".)

# ---------------------------------------------------------------------------
# IDE / editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets / local env
# ---------------------------------------------------------------------------
.env
.env.local
*.pem
*.key

# ---------------------------------------------------------------------------
# Logs / temp
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ---------------------------------------------------------------------------
# Large / generated genomic fixtures (fetch via scripts/parity/*)
# Small checked-in smoke fixtures under parity/fixtures/ are allowlisted.
# Verified pre-push: parity/realworld has multi-MB BAM/BAI and a ~3GB FASTA
# (hs37d5.simple.fa) — regenerate locally; never commit.
# ---------------------------------------------------------------------------
# Root-level dumps only — crate unit-test fixtures live under src/tests/test_data/.
/test_data/
*.bam
*.bai
*.sam
*.vcf
*.vcf.gz
*.fa
*.fasta
*.fq
*.fastq
*.fastq.gz
*.bam.gz
*.fa.gz
*.bed

# Small checked-in smoke / unit fixtures (realworld assets stay ignored below).
!parity/fixtures/**
!parity/expected/**
!gatk-core/src/tests/test_data/
!gatk-core/src/tests/test_data/**

# Large downloaded real-world assets
parity/realworld/assets/*.fa
parity/realworld/assets/*.fa.fai
parity/realworld/assets/*.dict
parity/realworld/assets/*.vcf.gz
parity/realworld/assets/*.bed
!parity/realworld/assets/.gitkeep
# Staged GIAB window / NA12878 BAM slices (scripts/parity/realworld/)
parity/realworld/na12878_giab_window_*/
parity/realworld/na12878_20k_*/
# Generated synthetic joint-cohort scale fixtures (scripts/parity/generate_synthetic_cohort_gvcfs.py)
parity/combine_gvcfs/cohort_scale/
# Local CombineGVCFs smoke cache (regenerable; contains machine-local paths)
parity/combine_gvcfs/prod_cohort_cache/
# GIAB multi-sample truth / runs
parity/giab/truth/
parity/giab/stratifications/
parity/giab/runs/

parity/build/
parity/reports/
parity/fixtures/hc-full-parity/java_dumps/**/*.stderr

# Small oracle fixtures used by HC EventMap / 6R regression tests
!gatk-haplotypecaller/tests/event_map/data/
!gatk-haplotypecaller/tests/event_map/data/**

# 6R forensic investigation reports — keep locally / archive privately, not in the public tree
/6R.*_REPORT.md
/6R*_REPORT.md
/docs/parity/*_REPORT.md

# ---------------------------------------------------------------------------
# Perf: keep aggregated reports; ignore raw timestamped run folders
# ---------------------------------------------------------------------------
/docs/perf/runs/
benchmark_results/
criterion/

# ---------------------------------------------------------------------------
# Dev audit intermediate dumps (baselines live in .quality-gates/)
# ---------------------------------------------------------------------------
/scripts/dev/*_inventory.txt

# ---------------------------------------------------------------------------
# Coverage / docs build / backups
# ---------------------------------------------------------------------------
tarpaulin/
coverage/
book/
docs/build/
*.bak
*.backup
actionlint
