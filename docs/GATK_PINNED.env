# Machine-readable GATK upstream pin (Phase A / P0).
# Source from bash:  source docs/GATK_PINNED.env
# Or use:           scripts/parity/lib_pinned_gatk.sh
#
# Changing this file requires regenerating Java L2 goldens and signing off parity tickets.

GATK_PINNED_REMOTE=https://github.com/broadinstitute/gatk.git
GATK_PINNED_REF=4.4.0.0
GATK_PINNED_SHA=2dbc025821bc5f686c423ff332a41e6cef892a77
GATK_PINNED_SHA_SHORT=2dbc0258

# Official Broad Docker image for this release (matches CI parity-smoke).
GATK_DOCKER_IMAGE=us.gcr.io/broad-gatk/gatk:4.4.0.0
GATK_DOCKER_PLATFORM=linux/amd64

# Jar inside the 4.4.0.0 container (for reference / custom JAR mounts).
GATK_JAR_BASENAME=gatk-package-4.4.0.0-local.jar

# Recorded when the pin was last verified (UTC).
GATK_PINNED_VERIFIED_DATE=2026-05-15
