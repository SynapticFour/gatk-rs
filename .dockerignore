# Rust build artifacts
target/
**/*.rs.bk
.pycache/
.pytest_cache/

# Keep Cargo.lock — required for reproducible release builds.

# Docs / site (not needed for the CLI image)
docs/
*.md
!README.md

# VCS
.git/
.gitignore
.gitattributes

# CI / IDE / OS
.github/
.travis.yml
.circleci/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs / temp
*.log
tmp/
temp/
*.tmp
*.bak
*.backup
.env
.env.local
.env.*.local

# Large / non-runtime fixtures (CLI image does not ship test data)
parity/build/
parity/reports/
parity/fixtures/**/*.bam
parity/fixtures/**/*.cram
test-data/
*.test
*.orig
*.rej
