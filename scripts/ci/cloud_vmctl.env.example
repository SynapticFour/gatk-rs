# Copy to a local untracked file (never commit secrets) or set as GitHub Actions secrets.
#   cp scripts/ci/cloud_vmctl.env.example /tmp/cloud_vmctl.env
#   # edit, then: set -a; source /tmp/cloud_vmctl.env; set +a

# hetzner | aws
# Genomewide correctness VM: set CLOUD_PROVIDER (+ SERVER/INSTANCE below).
# Perf benchmark VM: workflow uses CLOUD_PROVIDER_PERF + *_PERF_* IDs
# (see docs/ci/PERF_BENCHMARK_HOST.md). Never point both roles at one ID.
CLOUD_PROVIDER=hetzner

# --- Hetzner Cloud ---
HCLOUD_TOKEN=
# Numeric id from: hcloud server list
# Correctness (gatk-rs-genomewide):
HCLOUD_SERVER_ID=
# Perf only (gatk-rs-benchmark) — GitHub secret HCLOUD_PERF_SERVER_ID:
# HCLOUD_PERF_SERVER_ID=

# --- AWS EC2 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# Correctness:
# AWS_INSTANCE_ID=i-0123456789abcdef0
# Perf only (prefer c7i/c6i) — GitHub secret AWS_PERF_INSTANCE_ID:
# AWS_PERF_INSTANCE_ID=i-0perfbenchmark00

# Seconds to wait after power-on before declaring start complete (fallback if no GH wait).
CLOUD_VM_BOOT_GRACE_SEC=90

# Optional: GitHub PAT to poll runner online status (repo admin / Actions admin).
# GH_RUNNER_WAIT_TOKEN=
# GH_REPO=OWNER/gatk-rs
# RUNNER_LABEL=gatk-rs-genomewide   # or gatk-rs-benchmark for the perf host
# RUNNER_WAIT_TIMEOUT_SEC=600
